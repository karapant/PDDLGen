(define (domain transportPlanner)
  (:requirements :strips :typing :negative-preconditions :disjunctive-preconditions :fluents :durative-actions)
  (:types POI Passenger Bus coordinate)
  (:predicates
    (busatcoordinate ?p0 - Bus ?p1 - coordinate)
    (connected ?p0 - coordinate ?p1 - coordinate)
    (isbusstop ?p0 - coordinate)
    (passengerdropcoordinate ?p0 - Passenger ?p1 - coordinate)
    (passengerinbus ?p0 - Passenger ?p1 - Bus)
    (passengerneedsservice ?p0 - Passenger)
    (passengerpickcoordinate ?p0 - Passenger ?p1 - coordinate)
    (passengerserviced ?p0 - Passenger)
  )
  (:functions
    (azdistance ?p0 - coordinate ?p1 - coordinate)
    (azduration ?p0 - coordinate ?p1 - coordinate)
    (busseatingcapacity ?p0 - Bus)
    (noofpassengersinbus ?p0 - Bus)
    (passengerpickupwait ?p0 - Passenger)
    (total-cost)
  )
  (:durative-action drop-passenger
    :parameters (?p0 - Passenger ?p1 - Bus ?p2 - coordinate)
    :duration (= ?duration 0)
    :condition (and (at start (passengerdropcoordinate ?p0 ?p2)) (at start (busatcoordinate ?p1 ?p2)) (at start (isbusstop ?p2)) (at start (passengerinbus ?p0 ?p1)))
    :effect (and (at start (increase (busseatingcapacity ?p1) 1)) (at start (not (passengerdropcoordinate ?p0 ?p2))) (at start (not (passengerinbus ?p0 ?p1))) (at start (passengerserviced ?p0)) (at end (decrease (total-cost) 1)))
  )
  (:durative-action move-to-next-poi
    :parameters (?p0 - Bus ?p1 - coordinate ?p2 - coordinate)
    :duration (= ?duration (azduration ?p2 ?p1))
    :condition (and (at start (busatcoordinate ?p0 ?p2)) (at start (connected ?p2 ?p1)))
    :effect (and (at end (busatcoordinate ?p0 ?p1)) (at start (not (busatcoordinate ?p0 ?p2))) (at end (increase (total-cost) (azdistance ?p2 ?p1))))
  )
  (:durative-action pickup-passenger
    :parameters (?p0 - Passenger ?p1 - Bus ?p2 - coordinate)
    :duration (= ?duration 0)
    :condition (and (at start (busatcoordinate ?p1 ?p2)) (at start (>= (busseatingcapacity ?p1) 1)) (at start (isbusstop ?p2)) (at start (passengerneedsservice ?p0)) (at start (passengerpickcoordinate ?p0 ?p2)))
    :effect (and (at start (decrease (busseatingcapacity ?p1) 1)) (at start (passengerinbus ?p0 ?p1)) (at start (not (passengerneedsservice ?p0))) (at start (not (passengerpickcoordinate ?p0 ?p2))) (at end (decrease (total-cost) 1)))
  )
)
